# Copy to .env and adjust. Never commit .env.
NODE_ENV=development

# Matches docker-compose.yml defaults.
POSTGRES_USER=auto
POSTGRES_PASSWORD=auto
POSTGRES_DB=auto
POSTGRES_PORT=5432
DATABASE_URL=postgresql://auto:auto@localhost:5432/auto

# Neon: `neon env pull --file .env.local` writes DATABASE_URL (pooled, for the app) and
# DATABASE_URL_UNPOOLED (direct, used by Prisma CLI for migrations). .env.local wins over .env.
# DATABASE_URL_UNPOOLED=

# Optional: enables DB integration tests (they only touch rows they create).
# TEST_DATABASE_URL=postgresql://auto:auto@localhost:5432/auto
